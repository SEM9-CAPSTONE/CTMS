{
	"name": "ctms",
	"version": "0.1.0",
	"private": true,
	"description": "Camping Site and Trekking Management System monorepo",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"dev:quick": "pnpm --parallel --filter @ctms/api --filter @ctms/web dev",
		"dev:web": "pnpm --filter @ctms/web dev",
		"dev:mobile": "pnpm --filter @ctms/mobile start",
		"dev:api": "pnpm --filter @ctms/api start:dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint:all": "pnpm -r --if-present lint",
		"build:all": "pnpm -r --if-present build",
		"test:all": "pnpm -r --if-present test",
		"validate-branch": "node scripts/validate-branch-name.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json}": ["biome check --write --no-errors-on-unmatched"]
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	}
}
