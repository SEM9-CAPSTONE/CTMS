{
  "name": "ctms",
  "version": "0.1.0",
  "private": true,
  "description": "Camping Site and Trekking Management System monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:quick": "pnpm --parallel --filter @ctms/api --filter @ctms/web dev",
    "dev:web": "pnpm --filter @ctms/web dev",
    "dev:mobile": "pnpm --filter @ctms/mobile start",
    "dev:api": "pnpm --filter @ctms/api start:dev",
    "lint:all": "pnpm -r --if-present lint",
    "build:all": "pnpm -r --if-present build",
    "test:all": "pnpm -r --if-present test"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
