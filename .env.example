API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api
# Public browser key used when building the web app.
VITE_MAPTILER_API_KEY=
DATABASE_URL=postgresql://ctms:ctms@localhost:5432/ctms
TEST_DATABASE_URL=postgresql://ctms:ctms@127.0.0.1:5432/ctms_test
REDIS_URL=redis://localhost:6379
# Backend key used for terrain/elevation analysis.
MAPTILER_API_KEY=
ROUTE_TERRAIN_ROAD_ENABLED=true
AI_SERVICE_URL=http://localhost:8000
KNOWLEDGE_SERVICE_URL=http://localhost:8001
KNOWLEDGE_SERVICE_TOKEN=
KNOWLEDGE_WORKER_ENABLED=true
JWT_SECRET=change-me
OTP_TTL_MINUTES=10
OTP_RESEND_MAX_ATTEMPTS=4
OTP_VERIFY_MAX_ATTEMPTS=4
OTP_RESEND_WINDOW_MINUTES=1440
BOOKING_HOLD_TTL_MINUTES=120
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
WEATHER_API_TIMEOUT_MS=8000

# Host overview display policy (does not change weather/booking hard rules)
HOST_OVERVIEW_TIME_ZONE=Asia/Ho_Chi_Minh
HOST_OVERVIEW_WEATHER_MAX_AGE_SECONDS=3600
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/trips
PAYOS_CANCEL_URL=http://localhost:5173/trips
BOOKING_EXPIRY_WORKER_ENABLED=true
BOOKING_EXPIRY_INTERVAL_MS=30000
TRIP_AUTO_CANCEL_WORKER_ENABLED=true
TRIP_AUTO_CANCEL_INTERVAL_MS=60000
TRIP_STATUS_WORKER_ENABLED=true
TRIP_STATUS_WORKER_INTERVAL_MS=60000
PORTER_REQUEST_TTL_HOURS=48
PORTER_REQUEST_EXPIRY_WORKER_ENABLED=true
# CTMS-93: re-forecast upcoming Trips (daily, every 6 h within 3 days) and notify level changes
TRIP_WEATHER_MONITOR_WORKER_ENABLED=true
TRIP_WEATHER_MONITOR_INTERVAL_MS=900000
# Weather decision reminders near departure (T-48h Host, T-24h/T-12h/T-6h Admin)
TRIP_WEATHER_DECISION_WORKER_ENABLED=true
TRIP_WEATHER_DECISION_INTERVAL_MS=900000
# CTMS-82: real-time events kept for missed-event recovery after a WebSocket reconnect
REALTIME_EVENT_RETENTION_HOURS=24
REALTIME_RESUME_LIMIT=200
REALTIME_EVENT_PRUNE_WORKER_ENABLED=true
REALTIME_EVENT_PRUNE_INTERVAL_MS=3600000
# Bounded reconnect backoff sent to clients in the `connected` event
REALTIME_RECONNECT_INITIAL_DELAY_MS=1000
REALTIME_RECONNECT_MAX_DELAY_MS=30000
REALTIME_RECONNECT_MULTIPLIER=2
REALTIME_RECONNECT_JITTER_RATIO=0.2
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ROUTE_SAFETY_APPROVED_SOURCES=
ROUTE_SAFETY_PROXIMITY_METERS=300
ROUTE_SAFETY_CURRENT_AGE_MINUTES=360
ROUTE_SAFETY_INCIDENT_AGE_MINUTES=1440
# Fetch current NCHMF warnings before each route safety analysis.
ROUTE_SAFETY_LIVE_ENABLED=true
ROUTE_SAFETY_LIVE_TIMEOUT_MS=12000
ROUTE_SAFETY_NCHMF_BASE_URL=https://luquetsatlo.nchmf.gov.vn
ROUTE_SAFETY_NCHMF_BOUNDARIES_URL=https://geosllq.vndss.com/geoserversllq/ows

# Live disaster events and nearby mapped water resources
ROUTE_SAFETY_VNDMS_ENABLED=true
ROUTE_SAFETY_VNDMS_BASE_URL=https://vndms.gov.vn
ROUTE_SAFETY_WATER_ENABLED=true
ROUTE_SAFETY_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
ROUTE_SAFETY_OSM_MAP_URL=https://api.openstreetmap.org/api/0.6/map.json
ROUTE_SAFETY_CONTEXT_TIMEOUT_MS=20000

SURVIVAL_DOCUMENT_STORAGE_ROOT=.private-survival-documents
SURVIVAL_DOCUMENT_MAX_BYTES=10485760
OFFLINE_PACKAGE_STORAGE_ROOT=.private-offline-packages
OFFLINE_PACKAGE_WORKER_ENABLED=true
OPENAI_API_KEY=
AI_REVIEW_SERVICE_TOKEN=
GEMINI_API_KEY=
REVIEW_ANALYSIS_PROVIDER=openai
REVIEW_ANALYSIS_MODEL=gpt-4o-mini
REVIEW_ANALYSIS_CONFIG_VERSION=v1
REVIEW_ANALYSIS_WORKER_ENABLED=true
DEMAND_MIN_BOOKERS=10
DEMAND_MIN_DAYS_AFTER_CLOSE=3
DEMAND_MIN_HOSTS=3
DEMAND_MAX_HOST_SHARE=0.75
DEMAND_CONFIG_VERSION=v1
DEMAND_WORKER_ENABLED=true
