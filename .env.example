API_PORT=3000
DATABASE_URL=postgresql://ctms:ctms@localhost:5432/ctms
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me

# CTMS-02: account verification OTP (BR-006 expiry, BR-007 resend limit).
# These numbers are a DEVELOPMENT DEFAULT only, not a business rule and not a
# spec-mandated value — TTL and resend limit are logged as Deferred Decision
# in Decision Gate v2 (spec only says "according to system configuration").
# Tech Lead/Product Owner may change them at any time by editing the
# environment — zero code change required. Application code must read these
# via ConfigService and must NEVER hardcode 10 / 5 / 1440 in business logic.
OTP_TTL_MINUTES=10
OTP_RESEND_MAX_ATTEMPTS=5
OTP_RESEND_WINDOW_MINUTES=1440

# CTMS-03: login token lifetimes. Dev defaults only, not a business rule (spec
# does not mandate a specific TTL) — Tech Lead/PO may change these via env,
# zero code change required. Read via ConfigService, never hardcoded.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
