                <mxCell id="pl0" value="" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;strokeColor=#000000;fillColor=none;strokeWidth=1;dashed=1;" parent="1" vertex="1"><mxGeometry x="70" y="150" width="1" height="840" as="geometry"/></mxCell>
                <mxCell id="p1" value="Mobile App&#10;(API client)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="160" y="75" width="140" height="915" as="geometry"/></mxCell>
                <mxCell id="a1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p1" vertex="1"><mxGeometry x="65" y="80" width="10" height="795" as="geometry"/></mxCell>
                <mxCell id="p2" value="GpsTrackingController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="350" y="75" width="140" height="915" as="geometry"/></mxCell>
                <mxCell id="a2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p2" vertex="1"><mxGeometry x="65" y="110" width="10" height="710" as="geometry"/></mxCell>
                <mxCell id="p3" value="GpsTrackingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="540" y="75" width="140" height="915" as="geometry"/></mxCell>
                <mxCell id="a3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p3" vertex="1"><mxGeometry x="65" y="140" width="10" height="650" as="geometry"/></mxCell>
                <mxCell id="p4" value="PostgreSQL Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="730" y="75" width="140" height="915" as="geometry"/></mxCell>
                <mxCell id="m1" value="1. Start tracking on an ongoing Trip" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="160" as="sourcePoint"/><mxPoint x="225" y="160" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m2" value="2. GET /trips/:tripId/gps-tracking/context" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="190" as="sourcePoint"/><mxPoint x="415" y="190" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m3" value="3. getTrackingContext(userId, tripId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="220" as="sourcePoint"/><mxPoint x="605" y="220" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m4" value="4. Find Trip, Camper booking_member, Porter assignment" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="250" as="sourcePoint"/><mxPoint x="795" y="250" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m5" value="5. Return Trip status and participation" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="280" as="sourcePoint"/><mxPoint x="615" y="280" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m6" value="6. Not a participant: 403; eligible = Trip ongoing AND Camper joined / Porter assigned" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="310" as="sourcePoint"/><mxPoint x="610" y="335" as="targetPoint"/><Array as="points"><mxPoint x="640" y="310"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell>
                <mxCell id="m7" value="7. Return { eligible, reason, sampling 10s, logging 30s, configVersion }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="355" as="sourcePoint"/><mxPoint x="425" y="355" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m8" value="8. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="385" as="sourcePoint"/><mxPoint x="235" y="385" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m9" value="9. Sample GPS every 10s, keep a log every 30s with client UUID" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="415" as="sourcePoint"/><mxPoint x="230" y="440" as="targetPoint"/><Array as="points"><mxPoint x="260" y="415"/><mxPoint x="260" y="440"/></Array></mxGeometry></mxCell>
                <mxCell id="m10" value="10. POST /trips/:tripId/gps-logs { logs[] }" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="460" as="sourcePoint"/><mxPoint x="415" y="460" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m11" value="11. ingestLogs(userId, tripId, dto)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="490" as="sourcePoint"/><mxPoint x="605" y="490" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m12" value="12. Resolve Trip and participant" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="520" as="sourcePoint"/><mxPoint x="795" y="520" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m13" value="13. Return Trip window, checkedInAt / leftAt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="550" as="sourcePoint"/><mxPoint x="615" y="550" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="f14" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="550" y="580" width="330" height="90" as="geometry"/></mxCell>
                <mxCell id="c15" value="[for each log in the batch, de-duplicated by id]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="605" y="580" width="270" height="25" as="geometry"/></mxCell>
                <mxCell id="m16" value="14. Trip ongoing/completed AND eventTime inside participation window, else REJECTED + reason" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="620" as="sourcePoint"/><mxPoint x="610" y="645" as="targetPoint"/><Array as="points"><mxPoint x="640" y="620"/><mxPoint x="640" y="645"/></Array></mxGeometry></mxCell>
                <mxCell id="m17" value="15. INSERT gps_logs ... ON CONFLICT (id) DO NOTHING" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="690" as="sourcePoint"/><mxPoint x="795" y="690" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m18" value="16. Return inserted ids" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="720" as="sourcePoint"/><mxPoint x="615" y="720" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m19" value="17. findOwners(not-inserted ids)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="750" as="sourcePoint"/><mxPoint x="795" y="750" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m20" value="18. Return owner (userId, tripId)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="780" as="sourcePoint"/><mxPoint x="615" y="780" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m21" value="19. Per log: ACCEPTED / DUPLICATE (own retry) / REJECTED (ID_CONFLICT)" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="810" as="sourcePoint"/><mxPoint x="610" y="835" as="targetPoint"/><Array as="points"><mxPoint x="640" y="810"/><mxPoint x="640" y="835"/></Array></mxGeometry></mxCell>
                <mxCell id="m22" value="20. Return results[] in request order" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="855" as="sourcePoint"/><mxPoint x="425" y="855" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m23" value="21. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="885" as="sourcePoint"/><mxPoint x="235" y="885" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m24" value="22. Mark ACCEPTED / DUPLICATE as synced; keep REJECTED with reason" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="915" as="sourcePoint"/><mxPoint x="230" y="940" as="targetPoint"/><Array as="points"><mxPoint x="260" y="915"/><mxPoint x="260" y="940"/></Array></mxGeometry></mxCell>
