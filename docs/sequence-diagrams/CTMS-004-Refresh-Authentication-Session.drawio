                <mxCell id="m9" value="5. lastActivityAt = now" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="375" as="sourcePoint"/><mxPoint x="415" y="375" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m10" value="6. Restart countdown from new lastActivityAt" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="405" as="sourcePoint"/><mxPoint x="230" y="430" as="targetPoint"/><Array as="points"><mxPoint x="260" y="405"/><mxPoint x="260" y="430"/></Array></mxGeometry></mxCell>
                <mxCell id="d11" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="170" y="450" width="330" height="10" as="geometry"/></mxCell>
                <mxCell id="c12" value="[deadline already passed, e.g. device slept]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="225" y="455" width="270" height="25" as="geometry"/></mxCell>
                <mxCell id="n13" value="Interaction does NOT revive the session -&gt; go to timeout check" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="240" y="485" width="460" height="20" as="geometry"/></mxCell>
                <mxCell id="n14" value="Idle check: countdown fires, or tab becomes visible again" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="240" y="560" width="460" height="20" as="geometry"/></mxCell>
                <mxCell id="m15" value="7. Read lastActivityAt" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="595" as="sourcePoint"/><mxPoint x="415" y="595" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m16" value="8. Remaining time &lt;= 0" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="625" as="sourcePoint"/><mxPoint x="235" y="625" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="f17" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="170" y="655" width="900" height="495" as="geometry"/></mxCell>
                <mxCell id="c18" value="[refresh token stored]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="225" y="655" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m19" value="9. POST /auth/logout { refreshToken, allDevices: false }" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="695" as="sourcePoint"/><mxPoint x="605" y="695" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m20" value="10. logout(userId, dto)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="725" as="sourcePoint"/><mxPoint x="795" y="725" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m21" value="11. Find refresh_tokens by sha256(refreshToken)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="755" as="sourcePoint"/><mxPoint x="985" y="755" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m22" value="12. Return token row" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="785" as="sourcePoint"/><mxPoint x="805" y="785" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="f23" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="170" y="815" width="900" height="240" as="geometry"/></mxCell>
                <mxCell id="c24" value="[token found and belongs to user]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="225" y="815" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m25" value="13. revokeIfActive(token) -- Transaction" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="855" as="sourcePoint"/><mxPoint x="985" y="855" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m26" value="14. INSERT audit_logs (action = auth.logout)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="885" as="sourcePoint"/><mxPoint x="985" y="885" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m27" value="15. Return { loggedOut: true }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="915" as="sourcePoint"/><mxPoint x="615" y="915" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m28" value="16. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="945" as="sourcePoint"/><mxPoint x="235" y="945" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d29" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="170" y="975" width="900" height="10" as="geometry"/></mxCell>
                <mxCell id="c30" value="[token not found or not owned by user]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="225" y="980" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m31" value="17. Return 401 Unauthorized" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="1020" as="sourcePoint"/><mxPoint x="235" y="1020" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d32" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="170" y="1075" width="900" height="10" as="geometry"/></mxCell>
                <mxCell id="c33" value="[no refresh token stored, or logout request fails]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="225" y="1080" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="n34" value="Skip / ignore server error: the local session is still ended" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="240" y="1110" width="460" height="20" as="geometry"/></mxCell>
                <mxCell id="m35" value="18. Clear session data" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="1170" as="sourcePoint"/><mxPoint x="415" y="1170" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="n36" value="Removes accessToken, refreshToken, authUser, lastActivityAt; writes authSessionSignal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="240" y="1190" width="520" height="20" as="geometry"/></mxCell>
                <mxCell id="n37" value="Other open CTMS tabs receive the storage event and redirect to /login" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="430" y="1215" width="460" height="20" as="geometry"/></mxCell>
                <mxCell id="m38" value="19. Redirect to Login page (must log in again)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1250" as="sourcePoint"/><mxPoint x="70" y="1250" as="targetPoint"/></mxGeometry></mxCell>
            </root>
        </mxGraphModel>
