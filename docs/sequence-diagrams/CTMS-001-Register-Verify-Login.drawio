    <diagram id="verify-otp" name="Verify Account via OTP or Email (CTMS-002)">
        <mxGraphModel dx="942" dy="448" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1435" background="#ffffff" math="0" shadow="0">
