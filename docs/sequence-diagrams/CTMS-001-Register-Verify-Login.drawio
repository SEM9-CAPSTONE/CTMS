                <mxCell id="title" value="Verify Account via OTP or Email (CTMS-002)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1070" height="30" as="geometry"/></mxCell>
                <mxCell id="p0" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="55" y="65" width="30" height="60" as="geometry"/></mxCell>
                <mxCell id="pl0" value="" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;strokeColor=#000000;fillColor=none;strokeWidth=1;dashed=1;" parent="1" vertex="1"><mxGeometry x="70" y="150" width="1" height="1245" as="geometry"/></mxCell>
                <mxCell id="p1" value="Web / Mobile App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="160" y="75" width="140" height="1320" as="geometry"/></mxCell>
                <mxCell id="a1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p1" vertex="1"><mxGeometry x="65" y="80" width="10" height="1165" as="geometry"/></mxCell>
                <mxCell id="p2" value="AuthController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="350" y="75" width="140" height="1320" as="geometry"/></mxCell>
                <mxCell id="a2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p2" vertex="1"><mxGeometry x="65" y="110" width="10" height="1105" as="geometry"/></mxCell>
                <mxCell id="p3" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="540" y="75" width="140" height="1320" as="geometry"/></mxCell>
                <mxCell id="a3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p3" vertex="1"><mxGeometry x="65" y="140" width="10" height="1045" as="geometry"/></mxCell>
                <mxCell id="p4" value="PostgreSQL Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="730" y="75" width="140" height="1320" as="geometry"/></mxCell>
                <mxCell id="p5" value="OTP Delivery Provider&#10;(Twilio SMS / SMTP Email)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="920" y="75" width="140" height="1320" as="geometry"/></mxCell>
                <mxCell id="a5" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p5" vertex="1"><mxGeometry x="65" y="275" width="10" height="45" as="geometry"/></mxCell>
                <mxCell id="m1" value="1. Choose OTP channel (SMS / Email)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="160" as="sourcePoint"/><mxPoint x="225" y="160" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m2" value="2. POST /auth/send-otp { userId, channel }" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="190" as="sourcePoint"/><mxPoint x="415" y="190" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m3" value="3. sendOtp(dto)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="220" as="sourcePoint"/><mxPoint x="605" y="220" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m4" value="4. Find User and existing verification_otps" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="250" as="sourcePoint"/><mxPoint x="795" y="250" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m5" value="5. Return User and OTP send history" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="280" as="sourcePoint"/><mxPoint x="615" y="280" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m6" value="6. planOtp: generate code, TTL, check resend window / limit (else 409)" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="310" as="sourcePoint"/><mxPoint x="610" y="335" as="targetPoint"/><Array as="points"><mxPoint x="640" y="310"/><mxPoint x="640" y="335"/></Array></mxGeometry></mxCell>
                <mxCell id="m7" value="7. send(channel, { email, phone }, code)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="355" as="sourcePoint"/><mxPoint x="985" y="355" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m8" value="8. Return delivery result" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="385" as="sourcePoint"/><mxPoint x="615" y="385" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m9" value="9. UPSERT verification_otps (codeHash, expiresAt, sendCount, failedAttempts = 0)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="415" as="sourcePoint"/><mxPoint x="795" y="415" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m10" value="10. Return UserProfileDto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="445" as="sourcePoint"/><mxPoint x="425" y="445" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m11" value="11. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="475" as="sourcePoint"/><mxPoint x="235" y="475" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m12" value="12. Show OTP input" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="505" as="sourcePoint"/><mxPoint x="70" y="505" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m13" value="13. Enter OTP code" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="535" as="sourcePoint"/><mxPoint x="225" y="535" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m14" value="14. POST /auth/verify { userId, code }" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="565" as="sourcePoint"/><mxPoint x="415" y="565" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m15" value="15. verifyOtp(dto)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="595" as="sourcePoint"/><mxPoint x="605" y="595" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m16" value="16. SELECT verification_otps WHERE userId FOR UPDATE -- Transaction" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="625" as="sourcePoint"/><mxPoint x="795" y="625" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m17" value="17. Return OTP record (codeHash, expiresAt, failedAttempts)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="655" as="sourcePoint"/><mxPoint x="615" y="655" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="f18" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="30" y="685" width="850" height="660" as="geometry"/></mxCell>
                <mxCell id="c19" value="[not expired AND failedAttempts &lt; 4 AND bcrypt.compare(code, codeHash)]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="685" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m20" value="18. UPDATE users SET status = active" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="725" as="sourcePoint"/><mxPoint x="795" y="725" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m21" value="19. DELETE verification_otps WHERE userId" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="755" as="sourcePoint"/><mxPoint x="795" y="755" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m22" value="20. INSERT audit_logs (action = auth.verify_otp), commit" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="785" as="sourcePoint"/><mxPoint x="795" y="785" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m23" value="21. Return UserProfileDto (active)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="815" as="sourcePoint"/><mxPoint x="425" y="815" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m24" value="22. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="845" as="sourcePoint"/><mxPoint x="235" y="845" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m25" value="23. Show success, navigate to Login" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="875" as="sourcePoint"/><mxPoint x="70" y="875" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d26" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="30" y="905" width="850" height="10" as="geometry"/></mxCell>
                <mxCell id="c27" value="[code incorrect AND failedAttempts &lt; 4] (BR-007)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="910" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m28" value="18.1 UPDATE verification_otps SET failedAttempts + 1, commit" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="950" as="sourcePoint"/><mxPoint x="795" y="950" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m29" value="19.1 Throw 409 Incorrect OTP" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="980" as="sourcePoint"/><mxPoint x="425" y="980" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m30" value="20.1 Return 409 error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="1010" as="sourcePoint"/><mxPoint x="235" y="1010" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m31" value="21.1 Show error, allow retry" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1040" as="sourcePoint"/><mxPoint x="70" y="1040" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d32" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="30" y="1070" width="850" height="10" as="geometry"/></mxCell>
                <mxCell id="c33" value="[failedAttempts &gt;= 4: locked, even if the code is correct] (BR-007)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="1075" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m34" value="18.2 Throw 409 Too many attempts" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="1115" as="sourcePoint"/><mxPoint x="425" y="1115" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m35" value="19.2 Return 409 error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="1145" as="sourcePoint"/><mxPoint x="235" y="1145" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m36" value="20.2 Ask user to request a new OTP (resend resets the counter)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1175" as="sourcePoint"/><mxPoint x="70" y="1175" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d37" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="30" y="1205" width="850" height="10" as="geometry"/></mxCell>
                <mxCell id="c38" value="[OTP not found / expired]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="1210" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m39" value="18.3 Throw 404 / 409" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="1250" as="sourcePoint"/><mxPoint x="425" y="1250" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m40" value="19.3 Return error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="1280" as="sourcePoint"/><mxPoint x="235" y="1280" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m41" value="20.3 Show error, allow resend" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="1310" as="sourcePoint"/><mxPoint x="70" y="1310" as="targetPoint"/></mxGeometry></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="login" name="Log In (CTMS-003)">
