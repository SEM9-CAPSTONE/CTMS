                <mxCell id="p2" value="AuthController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="350" y="75" width="140" height="705" as="geometry"/></mxCell>
                <mxCell id="a2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p2" vertex="1"><mxGeometry x="65" y="110" width="10" height="490" as="geometry"/></mxCell>
                <mxCell id="p3" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="540" y="75" width="140" height="705" as="geometry"/></mxCell>
                <mxCell id="a3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" parent="p3" vertex="1"><mxGeometry x="65" y="140" width="10" height="430" as="geometry"/></mxCell>
                <mxCell id="p4" value="PostgreSQL Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="730" y="75" width="140" height="705" as="geometry"/></mxCell>
                <mxCell id="m1" value="1. Submit Login form (identifier, password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="160" as="sourcePoint"/><mxPoint x="225" y="160" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m2" value="2. POST /auth/login" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="190" as="sourcePoint"/><mxPoint x="415" y="190" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m3" value="3. login(dto)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="220" as="sourcePoint"/><mxPoint x="605" y="220" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m4" value="4. findByEmailOrPhone (normalized identifier)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="250" as="sourcePoint"/><mxPoint x="795" y="250" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m5" value="5. Return User (status, passwordHash)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="280" as="sourcePoint"/><mxPoint x="615" y="280" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="f6" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="30" y="310" width="850" height="420" as="geometry"/></mxCell>
                <mxCell id="c7" value="[status = active AND bcrypt.compare(password, passwordHash)]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="310" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m8" value="6. Generate refresh token (random bytes, sha256 hash)" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="350" as="sourcePoint"/><mxPoint x="610" y="375" as="targetPoint"/><Array as="points"><mxPoint x="640" y="350"/><mxPoint x="640" y="375"/></Array></mxGeometry></mxCell>
                <mxCell id="m9" value="7. INSERT refresh_tokens (tokenHash, expiresAt) -- Transaction" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="395" as="sourcePoint"/><mxPoint x="795" y="395" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m10" value="8. INSERT audit_logs (action = auth.login)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="425" as="sourcePoint"/><mxPoint x="795" y="425" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m11" value="9. Sign JWT access token { sub, roles } after commit" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="455" as="sourcePoint"/><mxPoint x="610" y="480" as="targetPoint"/><Array as="points"><mxPoint x="640" y="455"/><mxPoint x="640" y="480"/></Array></mxGeometry></mxCell>
                <mxCell id="m12" value="10. Return { accessToken, refreshToken, user }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="500" as="sourcePoint"/><mxPoint x="425" y="500" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m13" value="11. Return 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="530" as="sourcePoint"/><mxPoint x="235" y="530" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m14" value="12. Store tokens, navigate to Dashboard" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="560" as="sourcePoint"/><mxPoint x="70" y="560" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="d15" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#000000;fillColor=none;" parent="1" vertex="1"><mxGeometry x="30" y="590" width="850" height="10" as="geometry"/></mxCell>
                <mxCell id="c16" value="[user not found / not active / wrong password]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="595" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m17" value="6.1 Throw 401 Unauthorized" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="635" as="sourcePoint"/><mxPoint x="425" y="635" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m18" value="7.1 Return 401 error" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="665" as="sourcePoint"/><mxPoint x="235" y="665" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m19" value="8.1 Show invalid credentials message" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="695" as="sourcePoint"/><mxPoint x="70" y="695" as="targetPoint"/></mxGeometry></mxCell>
