                <mxCell id="f6" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;fontColor=#000000;width=45;height=25;" parent="1" vertex="1"><mxGeometry x="30" y="310" width="850" height="405" as="geometry"/></mxCell>
                <mxCell id="c7" value="[email / phone not registered]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1"><mxGeometry x="85" y="310" width="520" height="25" as="geometry"/></mxCell>
                <mxCell id="m8" value="6. Hash password (bcrypt)" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="350" as="sourcePoint"/><mxPoint x="610" y="375" as="targetPoint"/><Array as="points"><mxPoint x="640" y="350"/><mxPoint x="640" y="375"/></Array></mxGeometry></mxCell>
                <mxCell id="m9" value="7. INSERT users (status = pending_verification) -- Transaction" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="395" as="sourcePoint"/><mxPoint x="795" y="395" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m10" value="8. INSERT audit_logs (action = auth.register)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615" y="425" as="sourcePoint"/><mxPoint x="795" y="425" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m11" value="9. Return created User" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="455" as="sourcePoint"/><mxPoint x="615" y="455" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m12" value="10. Return UserProfileDto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="485" as="sourcePoint"/><mxPoint x="425" y="485" as="targetPoint"/></mxGeometry></mxCell>
                <mxCell id="m13" value="11. Return 201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;edgeStyle=none;rounded=0;strokeColor=#000000;fontColor=#000000;fillColor=none;labelBackgroundColor=#ffffff;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="515" as="sourcePoint"/><mxPoint x="235" y="515" as="targetPoint"/></mxGeometry></mxCell>
