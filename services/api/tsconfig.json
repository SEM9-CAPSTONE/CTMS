{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"isolatedModules": true,
		"declaration": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "dist",
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts", "test/**/*.ts"]
}
