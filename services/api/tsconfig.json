{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"isolatedModules": true,
		"declaration": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"moduleResolution": "node16",
		"rootDir": ".",
		"outDir": "./dist",
		"declarationDir": "./dist",
		"sourceMap": true,
		"types": ["node", "jest"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
