{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"isolatedModules": true,
		"declaration": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"moduleResolution": "node16",
		"rootDir": "./src",
		"outDir": "./dist",
		"declarationDir": "./dist",
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts", "test/**/*.ts"]
}
