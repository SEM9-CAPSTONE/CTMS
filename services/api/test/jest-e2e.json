{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"globalSetup": "<rootDir>/test/setup-integration-database.ts",
	"setupFiles": ["<rootDir>/test/setup-integration-env.ts"],
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"testTimeout": 60000,
	"transform": { "^.+\\.(t|j)s$": "ts-jest" }
}
